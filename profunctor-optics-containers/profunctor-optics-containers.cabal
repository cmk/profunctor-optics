cabal-version: 2.0

name:           profunctor-optics-containers
version:        0.0.1
synopsis:       Profunctor optics for containers types.
description:
  Optics for types in the @containers@ package: Map, Seq, Tree, and List.
  .
  See the <https://github.com/cmk/profunctor-optics#readme README> for more information.

category:       Data, Lenses, Profunctors
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Data.Container.Pattern
      Data.List.Optic
      Data.Map.Optic
      Data.Map.NonEmpty.Optic
      Data.Sequence.Optic
      Data.Tree.Optic

  default-language: Haskell2010

  hs-source-dirs:
      src

  default-extensions:
      ConstraintKinds
      RankNTypes
      MultiParamTypeClasses
      FlexibleContexts
      FlexibleInstances
      QuantifiedConstraints
      ScopedTypeVariables
      TupleSections
      TypeOperators
      TypeApplications
      TypeFamilies

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , containers
    , nonempty-containers
    , profunctor-optics
    , scheme-extensions

test-suite props
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -threaded

  other-modules:
      Test.Prop.Container

  build-depends:
      base               >= 4.16  && < 5.0
    , containers
    , hedgehog           >= 1.0
    , profunctor-optics
    , profunctor-optics-containers
    , scheme-extensions
