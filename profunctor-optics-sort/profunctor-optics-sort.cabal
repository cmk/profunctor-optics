cabal-version: 2.0

name:           profunctor-optics-sort
version:        0.0.1
synopsis:       Profunctor-based sorting and grouping optics.
description:
  Profunctor sort with separated key, input, and output parameters.
  Three variants exploring the design space: Sort1 (non-empty in, can fail),
  Sort2 (non-empty in, groups can be empty), and Sort3 (representable in/out).

category:       Data, Lenses, Profunctors
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Data.Profunctor.Sort
      Data.Profunctor.Optic.Sort.Backend
      Data.Profunctor.Optic.Import

  default-language: Haskell2010

  hs-source-dirs:
      src

  default-extensions:
      DerivingVia
      FlexibleContexts
      FlexibleInstances
      MultiParamTypeClasses
      RankNTypes
      TupleSections
      TypeFamilies
      TypeOperators
      UndecidableInstances

  ghc-options: -Wall

  build-depends:
      base                   >= 4.16   && < 5.0
    , array                  >= 0.5
    , bytestring             >= 0.11
    , coapplicative          >= 0.0.2
    , containers             >= 0.5
    , hashable               >= 1.4
    , primitive              >= 0.7
    , profunctors            >= 5.4
    , profunctor-optics      >= 0.0.3
    , text                   >= 2.0
    , unordered-containers   >= 0.2
    , vector                 >= 0.12

benchmark sort-bench
  type:              exitcode-stdio-1.0
  main-is:           Main.hs
  ghc-options:       -Wall -O2 -rtsopts
  hs-source-dirs:    bench
  default-language:  Haskell2010

  default-extensions:
      FlexibleContexts
      MultiParamTypeClasses
      TypeFamilies

  build-depends:
      base
    , containers
    , criterion           >= 1.5
    , profunctors
    , profunctor-optics
    , profunctor-optics-sort
    , profunctor-optics-strings
    , scheme-extensions
    , transformers

test-suite properties
  type:              exitcode-stdio-1.0
  main-is:           Main.hs
  other-modules:     Test.Prop.Sort
  ghc-options:       -Wall -threaded
  hs-source-dirs:    test
  default-language:  Haskell2010

  default-extensions:
      FlexibleContexts
      MultiParamTypeClasses
      RankNTypes
      TupleSections
      TypeFamilies
      TypeOperators

  build-depends:
      base
    , bytestring
    , coapplicative
    , containers
    , hedgehog               >= 1.0
    , profunctors
    , profunctor-optics
    , array
    , hashable
    , primitive
    , profunctor-optics-sort
    , profunctor-optics-strings
    , scheme-extensions
    , text
    , unordered-containers
    , vector
