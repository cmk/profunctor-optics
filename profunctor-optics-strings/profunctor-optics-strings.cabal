cabal-version: 2.0

name:           profunctor-optics-strings
version:        0.0.1
synopsis:       Cotraversal-based Text/ByteString ops via profunctor optics.
description:    Treats fixed-size types (Word8, Word16, etc.) as Representable
                functors via index types from scheme-extensions, giving
                cotraversals/grates for bit-level access. Variable-length
                strings use Cons-based recursion schemes.
                Replaces the MonoTraversable approach in profunctor-optics-sequences.
category:       Data, Optics
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2026 Chris McKinlay
license:        BSD3
build-type:     Simple

library
  exposed-modules:
      Data.Word.Optic
      Data.ByteString.Optic
      Data.Text.Optic

  default-language: Haskell2010

  hs-source-dirs:
      src

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , bytestring
    , profunctor-optics
    , scheme-extensions
    , text
    , text-short

test-suite props
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -threaded

  other-modules:
      Test.Prop.Word
      Test.Prop.ByteString
      Test.Prop.Split
      Test.Prop.Text

  build-depends:
      base               >= 4.16  && < 5.0
    , bytestring
    , hedgehog           >= 1.0
    , profunctor-optics
    , profunctor-optics-strings
    , scheme-extensions
    , text
    , text-short

benchmark bench
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  default-language: Haskell2010
  ghc-options: -Wall -O2 -threaded

  build-depends:
      base               >= 4.16  && < 5.0
    , bytestring
    , criterion          >= 1.5
    , profunctor-optics
    , profunctor-optics-strings
    , scheme-extensions
    , text
