cabal-version: 2.0

name:           profunctor-optics-sequences
version:        0.0.1
synopsis:       Sequence and container optics for profunctor-optics.
description:
  Moore and Mealy machine optics for mono-traversable sequences:
  packing, chunking, filtering, partitioning, and pattern synonyms
  for strict\/lazy\/chunked\/packed conversions.
  .
  See the <https://github.com/cmk/profunctor-optics#readme README> for more information.

category:       Data, Lenses, Profunctors
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Data.Profunctor.Optic.Sequence
      Data.Profunctor.Optic.Pattern

  default-language: Haskell2010

  hs-source-dirs:
      src

  default-extensions:
      FlexibleContexts
      QuantifiedConstraints
      RankNTypes
      MultiParamTypeClasses
      TupleSections
      TypeOperators
      TypeFamilies
      PatternSynonyms
      ViewPatterns

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , mono-traversable
    , profunctor-optics
    , profunctor-optics-folds
    , semigroupoids
