cabal-version: 2.0

name:           profunctor-optics-th
version:        0.0.1
synopsis:       Template Haskell generation of profunctor optics.
description:
  Generate profunctor-based lenses, traversals, and prisms via
  Template Haskell, adapted from microlens-th.
  .
  See the <https://github.com/cmk/profunctor-optics#readme README> for more information.

category:       Data, Lenses, Profunctors
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Data.Profunctor.Optic.TH

  other-modules:
      Data.Profunctor.Optic.TH.Internal

  default-language: Haskell2010

  hs-source-dirs:
      src

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , containers
    , transformers
    , template-haskell   >= 2.16
    , th-abstraction     >= 0.4
    , semigroupoids
    , profunctor-optics

test-suite templates
  type:              exitcode-stdio-1.0
  main-is:           templates.hs
  ghc-options:       -Wall -threaded
  hs-source-dirs:    test
  default-language:  Haskell2010

  build-depends:
      base
    , profunctor-optics
    , profunctor-optics-th
