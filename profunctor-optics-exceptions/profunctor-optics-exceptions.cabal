cabal-version: 2.0

name:           profunctor-optics-exceptions
version:        0.0.1
synopsis:       Exception optics for profunctor-optics.
description:
  Prisms into GHC exception types, lenses into IOException fields,
  and MonadUnliftIO-based catch\/try\/handle operators that select
  exceptions via profunctor optics.
  .
  See the <https://github.com/cmk/profunctor-optics#readme README> for more information.

category:       Data, Lenses, Profunctors, Exceptions
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Control.Exception.Optic

  default-language: Haskell2010

  hs-source-dirs:
      src

  default-extensions:
      RankNTypes
      PatternSynonyms
      ViewPatterns
      ScopedTypeVariables
      QuantifiedConstraints

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , fault
    , profunctor-optics
    , unliftio-core
