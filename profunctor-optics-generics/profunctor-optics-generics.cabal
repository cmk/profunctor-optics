cabal-version: 2.0

name:           profunctor-optics-generics
version:        0.0.1
synopsis:       Newtype and GHC.Generics optics for profunctor-optics.
description:
  Isos for newtype wrappers via @newtype-generics@, plus the classic
  @ala@ combinator from Conor McBride.
  .
  See the <https://github.com/cmk/profunctor-optics#readme README> for more information.

category:       Data, Lenses, Profunctors, Generics
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Data.Profunctor.Optic.Newtype

  default-language: Haskell2010

  hs-source-dirs:
      src

  default-extensions:
      RankNTypes
      QuantifiedConstraints
      FlexibleContexts
      TypeFamilies

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , newtype-generics
    , profunctor-optics
