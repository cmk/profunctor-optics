cabal-version: 2.0

name:           profunctor-optics-folds
version:        0.0.1
synopsis:       Foldl carrier profunctors and Moore/Mealy machine optics.
description:
  Strict left fold carrier profunctors (@Foldl@, @Foldl1@) with
  Profunctor, Closed, Corepresentable, Distributive instances, plus
  Moore and Mealy machine optics built on top of them.
  .
  See the <https://github.com/cmk/profunctor-optics#readme README> for more information.

category:       Data, Lenses, Profunctors
stability:      Experimental
homepage:       https://github.com/cmk/profunctor-optics
bug-reports:    https://github.com/cmk/profunctor-optics/issues
author:         Chris McKinlay
maintainer:     Chris McKinlay
copyright:      2019-2026 Chris McKinlay
license:        BSD3
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/cmk/profunctor-optics

library
  exposed-modules:
      Data.Profunctor.Rep.Foldl
      Data.Profunctor.Rep.Foldl1
      Data.Profunctor.Optic.Machine

  default-language: Haskell2010

  hs-source-dirs:
      src

  default-extensions:
      ExistentialQuantification
      FlexibleContexts
      FlexibleInstances
      MultiParamTypeClasses
      QuantifiedConstraints
      RankNTypes
      TypeFamilies
      TypeOperators
      BangPatterns
      TupleSections
      NoImplicitPrelude

  ghc-options: -Wall

  build-depends:
      base               >= 4.16  && < 5.0
    , adjunctions
    , distributive
    , profunctors
    , semigroupoids
    , mtl
    , strict
    , profunctor-optics
